<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dk.froekjaer.open-webui</string>

  <key>UserName</key>
  <string>peter</string>

  <key>WorkingDirectory</key>
  <string>/Users/peter/projects/openwebui-env</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/peter/projects/openwebui-env/bin/open-webui</string>
    <string>serve</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8080</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/peter</string>
    <key>PATH</key>
    <string>/Users/peter/projects/openwebui-env/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>DATA_DIR</key>
    <string>/Volumes/data-fast/peter-home/open-webui-data</string>
    <key>WEBUI_SECRET_KEY_FILE</key>
    <string>/Volumes/data-fast/peter-home/open-webui-data/.webui_secret_key</string>
    <key>OLLAMA_BASE_URL</key>
    <string>http://127.0.0.1:11434</string>
    <key>CORS_ALLOW_ORIGIN</key>
    <string>https://openwebui.froekjaer.dk;https://timelapse.froekjaer.dk</string>
    <key>WEBUI_AUTH_TRUSTED_EMAIL_HEADER</key>
    <string>X-Timelapse-User-Email</string>
    <key>WEBUI_AUTH_TRUSTED_NAME_HEADER</key>
    <string>X-Timelapse-User-Name</string>
    <key>WEBUI_AUTH_TRUSTED_ROLE_HEADER</key>
    <string>X-Timelapse-User-Role</string>
    <key>WEBUI_AUTH_SIGNOUT_REDIRECT_URL</key>
    <string>https://timelapse.froekjaer.dk/openwebui</string>
    <key>WEBUI_SESSION_COOKIE_SECURE</key>
    <string>true</string>
    <key>WEBUI_SESSION_COOKIE_SAME_SITE</key>
    <string>lax</string>
    <key>WEBUI_AUTH_COOKIE_SAME_SITE</key>
    <string>lax</string>
    <key>TOOL_SERVER_CONNECTIONS</key>
    <string>[{"url":"http://127.0.0.1:8000","path":"/api/openwebui/tools/openapi.json","auth_type":"none","config":{"enable":true},"info":{"id":"timelapse-pro","name":"TimeLapse Pro","description":"Read-only drift, compliance, update and AI Ops context"}}]</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/peter/Library/Logs/open-webui.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/peter/Library/Logs/open-webui.log</string>

  <!-- RETTET 2026-07-06/07 efter fejlagtigt forsøg på "on-demand via toggle":
       Open WebUI er IKKE en on-demand-tjeneste. Den er allerede installeret
       som en SYSTEM-LaunchDaemon (/Library/LaunchDaemons/dk.froekjaer.open-webui.plist,
       oprettet 28. maj 2026) og kører KONSTANT i baggrunden, ligesom headend,
       PostgreSQL og nginx — jf. SERVICES_OG_DRIFT_kilde_til_sandhed.md. Denne
       fil her (deploy/launchd/) er kilde-kopien til den daemon, ikke en separat
       LaunchAgent.

       "Peter vil gerne lege med Ollama"-toggle'en (PUT /api/ai/ollama-priority)
       har ALDRIG haft til opgave at starte/stoppe denne webserver — den styrer
       kun ressourceprioritet på selve Ollama-modellen, uafhængigt af om
       Open WebUI's HTTP-server kører.

       Den oprindelige fejl ("127.0.0.1:8080 ikke tilgængelig") skyldtes IKKE en
       manglende starttrigger, men at denne daemon crash-loopede (29.564
       registrerede genstarter, se `launchctl print system/dk.froekjaer.open-webui`)
       pga. (1) macOS Finder Icon\r-filer i venv'et der knækkede Pythons
       pathlib.iterdir(), og (2) TCC-beskyttelse af removable volumes, der
       blokerede launchd-spawnede processers adgang til venv'et på USB-drevet
       /Volumes/data-fast (Peter gav Full Disk Access til Homebrew Python@3.12
       via Systemindstillinger 2026-07-07). Begge er nu rettet, og daemonen
       kører stabilt (verificeret: HTTP 200 lokalt, HTTP 302 via nginx uden login).

       RunAtLoad=true + KeepAlive=true er derfor korrekt — det matcher den
       faktiske, allerede-fungerende deployment. Et separat eksperiment med
       RunAtLoad=false/KeepAlive=false som en gui-domæne LaunchAgent er forkastet
       (den var i konflikt med denne daemon om port 8080).

       TILFØJET 2026-07-07: DATA_DIR flyttet fra /Users/peter/.open-webui (intern
       disk) til /Volumes/data-fast/peter-home/open-webui-data (USB-drevet) —
       Peter ville undgå at chat-historik/uploads/vector-database vokser på den
       interne disk (kun 53 GB fri), i tråd med at openwebui-env allerede ligger
       på USB'en. Muliggjort af Full Disk Access-tildelingen ovenfor, som dækker
       ALLE stier processen tilgår, ikke kun venv'et. WEBUI_SECRET_KEY_FILE er nu
       eksplicit sat til en fil i DATA_DIR (ikke i venv'et), så nøglen ikke går
       tabt hvis openwebui-env geninstalleres. Gammel data ligger stadig urørt i
       /Users/peter/.open-webui som backup, ikke slettet. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
