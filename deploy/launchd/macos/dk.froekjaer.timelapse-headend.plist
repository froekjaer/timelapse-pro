<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dk.froekjaer.timelapse-headend</string>
  <key>UserName</key>
  <string>peter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/timelapse-headend-start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/peter</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TIMELAPSE_HEADEND_ENV_FILE</key>
    <string>/etc/timelapse/headend.env</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/peter/Library/Logs/timelapse-headend.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/peter/Library/Logs/timelapse-headend.log</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- KeepAlive with SuccessfulExit=false means only restart on unexpected crash -->
  <!-- Clean exit (exit code 0) will NOT restart - prevents restart loops on startup errors -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <!-- Maximum 5 rapid failures in 60 seconds before giving up -->
    <key>CrashCount</key>
    <integer>5</integer>
  </dict>
  <!-- ThrottleInterval increased to 30s to prevent aggressive restart loops -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
