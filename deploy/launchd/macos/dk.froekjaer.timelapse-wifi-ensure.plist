<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dk.froekjaer.timelapse-wifi-ensure</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/timelapse-wifi-ensure</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TIMELAPSE_WIFI_ENV_FILE</key>
    <string>/etc/timelapse/wifi.env</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/var/log/timelapse-wifi-ensure.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/timelapse-wifi-ensure.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
</dict>
</plist>
