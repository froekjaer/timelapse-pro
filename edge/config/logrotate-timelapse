# TimeLapse Pro — log rotation (edge)
# Placeres i /etc/logrotate.d/timelapse

/var/log.hdd/timelapse/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    postrotate
        # Genstart dnsmasq så den skriver til ny fil
        kill -HUP $(cat /run/timelapse/dnsmasq-bt.pid 2>/dev/null) 2>/dev/null || true
    endscript
}
