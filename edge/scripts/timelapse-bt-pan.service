[Unit]
Description=TimeLapse Pro — Bluetooth PAN (NAP server)
After=bluetooth.service sys-subsystem-bluetooth-devices-hci0.device
Wants=bluetooth.service
Before=timelapse-local-mgmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/opt/timelapse/edge/scripts/timelapse-bt-pan.sh
ExecStop=/bin/bash -c '\
    busctl call org.bluez /org/bluez/hci0 org.bluez.NetworkServer1 Unregister s "nap" 2>/dev/null; \
    kill $(cat /run/timelapse/dnsmasq-bt.pid 2>/dev/null) 2>/dev/null; \
    ip link del br-bt 2>/dev/null; \
    bluetoothctl discoverable off 2>/dev/null; \
    true'
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
