[Unit]
Description=TimeLapse Pro — BT captive portal (iptables)
After=timelapse-bt-pan.service
Requires=timelapse-bt-pan.service
Before=timelapse-totp.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/timelapse/edge/scripts/timelapse-captive.sh start
ExecStop=/bin/bash /opt/timelapse/edge/scripts/timelapse-captive.sh stop

[Install]
WantedBy=multi-user.target
