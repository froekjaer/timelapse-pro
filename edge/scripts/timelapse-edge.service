[Unit]
Description=TimeLapse Pro Edge Agent
Documentation=https://github.com/yourorg/timelapse-pro
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# Do not start until the SSD is mounted
RequiresMountsFor=/data

[Service]
Type=simple
# The agent performs verified artifact installation and hardware control.  The
# deployed production unit runs as root; keep this source unit aligned so an
# artifact update cannot silently downgrade its own operational permissions.
User=root
Group=root
WorkingDirectory=/opt/timelapse/edge

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/timelapse/edge

# Main process
ExecStart=/opt/timelapse/venv/bin/python /opt/timelapse/edge/agent.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy — always restart, even on clean exit
Restart=always
RestartSec=10
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timelapse-edge

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=timelapse
RuntimeDirectoryMode=0755
ProtectSystem=strict
ReadWritePaths=/data /opt/timelapse /opt/timelapse/edge /run/timelapse /etc/timelapse /etc/ssh/sshd_config
ReadWritePaths=-/home/orangepi/.ssh -/home/pi/.ssh -/home/ubuntu/.ssh -/home/timelapse/.ssh
ReadWritePaths=/etc/systemd/system/timelapse-edge.service /etc/systemd/system/timelapse-bt-pan.service /etc/systemd/system/timelapse-bt-agent.service /etc/systemd/system/timelapse-captive.service /etc/systemd/system/timelapse-totp.service
ProtectHome=yes

[Install]
WantedBy=multi-user.target
