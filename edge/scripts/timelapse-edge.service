[Unit]
Description=TimeLapse Pro Edge Agent
Documentation=https://github.com/yourorg/timelapse-pro
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# Do not start until the SSD is mounted
RequiresMountsFor=/data

[Service]
Type=simple
# The agent performs verified artifact installation and hardware control.  The
# deployed production unit runs as root; keep this source unit aligned so an
# artifact update cannot silently downgrade its own operational permissions.
User=root
Group=root
WorkingDirectory=/opt/timelapse/edge

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/timelapse/edge

# Main process
ExecStart=/opt/timelapse/venv/bin/python /opt/timelapse/edge/agent.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy — always restart, even on clean exit
Restart=always
RestartSec=10
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timelapse-edge

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=timelapse
RuntimeDirectoryMode=0755
ProtectSystem=strict
# 2026-08-25: four separate incidents in one night (sshd_config, .ssh
# authorized_keys dirs, /var/log.hdd/timelapse, and finally /etc/passwd's
# own atomic-rename temp file) all traced back to the same root cause —
# tools that do create-temp-then-rename (sshd itself, useradd, chpasswd)
# need write access to the CONTAINING DIRECTORY, not just the specific
# filename, because they create a NEW file first and only a directory
# grant covers that. Piecemeal single-file grants under ProtectSystem=strict
# kept missing this (note: ProtectSystem=full does NOT help here — it
# makes /etc read-only too, same as strict, it just doesn't ALSO cover
# every other path strict does). Granting /etc itself as ReadWritePaths is
# the actual fix. This agent's job is genuinely system provisioning
# (creates Linux accounts, manages sudoers and sshd config, manages its
# own and sibling systemd units) — /etc write access doesn't meaningfully
# over-privilege it beyond what running as root with unrestricted sudo
# grants (which it writes for itself) already does.
ReadWritePaths=/data /opt/timelapse /opt/timelapse/edge /run/timelapse /etc
ReadWritePaths=-/var/log.hdd/timelapse
ReadWritePaths=-/home/orangepi/.ssh -/home/pi/.ssh -/home/ubuntu/.ssh -/home/timelapse/.ssh -/home/emergency/.ssh -/home/servicetekniker/.ssh
ProtectHome=yes

[Install]
WantedBy=multi-user.target
