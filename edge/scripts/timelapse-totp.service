[Unit]
Description=TimeLapse Pro — TOTP captive portal (local management)
After=network.target timelapse-bt-pan.service var-log.hdd.mount
Wants=timelapse-bt-pan.service
RequiresMountsFor=/var/log.hdd

[Service]
Type=simple
User=root
WorkingDirectory=/opt/timelapse/edge/scripts

# Generer cert hvis det ikke findes
ExecStartPre=/bin/bash /opt/timelapse/edge/scripts/gen-bt-cert.sh

ExecStart=/opt/timelapse/venv/bin/python3 /opt/timelapse/edge/scripts/totp-service.py

Restart=on-failure
RestartSec=5

# Logging → /var/log.hdd/timelapse/ (ikke zram)
StandardOutput=append:/var/log.hdd/timelapse/totp-service.log
StandardError=append:/var/log.hdd/timelapse/totp-service.log

# Minimal security hardening (kræver root pga. iptables)
NoNewPrivileges=no
PrivateTmp=true

[Install]
WantedBy=multi-user.target
