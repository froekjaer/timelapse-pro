[Unit]
Description=TimeLapse Watchdog
After=network-online.target
Wants=network-online.target
# The watchdog is the independent recovery path for the Edge agent and its
# reverse management tunnel. Keep it independent of timelapse-edge.service.

[Service]
User=root
ExecStart=/opt/timelapse/edge/scripts/watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
