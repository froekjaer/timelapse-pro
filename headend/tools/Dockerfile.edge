####################################################################
# TimeLapse Pro — Edge node image (arm64 / Ubuntu 22.04)
#
# Build context: repo root (timelapse-pro/)
# Build:
#   docker buildx build --platform linux/arm64 \
#     -f headend/tools/Dockerfile.edge \
#     --build-arg HEADEND_URL=http://127.0.0.1:8000/api \
#     -t timelapse-edge:latest --load .
#
# Export rootfs:
#   docker export $(docker create timelapse-edge:latest) | gzip > rootfs.tar.gz
#
# Paths (match timelapse-edge.service):
#   Agent:  /opt/timelapse/edge/
#   Venv:   /opt/timelapse/venv/
#   Data:   /data/
#   Config: /etc/timelapse/
####################################################################
FROM arm64v8/ubuntu:22.04

ARG HEADEND_URL=http://127.0.0.1:8000/api
ARG TIMELAPSE_VERSION=unknown
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Copenhagen \
    TIMELAPSE_HEADEND_URL=${HEADEND_URL} \
    PYTHONUNBUFFERED=1

# ── Base packages ───────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        ca-certificates curl gnupg2 \
        openssh-server openssh-client \
        iproute2 iputils-ping dnsutils \
        rsync autossh gphoto2 libgphoto2-6 libgphoto2-port12 \
        gpsd gpsd-clients bluez \
    && rm -rf /var/lib/apt/lists/*

# ── Service user ─────────────────────────────────────────────────
RUN useradd -m -s /bin/bash timelapse \
    && passwd -l timelapse \
    && passwd -l root

# ── Hardening (SSH) ──────────────────────────────────────────────
RUN mkdir -p /run/sshd \
    && sed -i \
        -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/' \
        -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
        -e 's/^#\?ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' \
        /etc/ssh/sshd_config \
    && echo "AllowUsers timelapse" >> /etc/ssh/sshd_config

# ── Directory structure ──────────────────────────────────────────
RUN mkdir -p \
        /opt/timelapse/edge \
        /opt/timelapse/venv \
        /etc/timelapse \
        /data \
        /run/timelapse \
    && chown -R timelapse:timelapse \
        /opt/timelapse \
        /etc/timelapse \
        /data \
        /run/timelapse

# ── Python venv ──────────────────────────────────────────────────
# Et nyt image skal kunne udføre samme QA som en opdateret Edge fra første boot.
COPY edge/requirements.txt /tmp/requirements.edge.txt
# Build-deps installeres midlertidigt og fjernes igen i samme RUN-lag.
# libsodium23 (runtime) beholdes — pynacl linker mod det dynamisk.
# SODIUM_INSTALL=system: pynacl bruger system-libsodium (sparer kompileringstid).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc libffi-dev python3-dev make \
        libsodium23 libsodium-dev \
    && python3 -m venv /opt/timelapse/venv \
    && SODIUM_INSTALL=system /opt/timelapse/venv/bin/pip install --quiet --no-cache-dir \
        -r /tmp/requirements.edge.txt \
    && apt-get remove -y gcc libffi-dev python3-dev make libsodium-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ── Agent source ─────────────────────────────────────────────────
COPY edge/ /opt/timelapse/edge/
RUN rm -rf /opt/timelapse/edge/__pycache__ /opt/timelapse/edge/**/__pycache__ \
    && rm -f /opt/timelapse/edge/api_token.txt /opt/timelapse/edge/bootstrap.yaml \
             /opt/timelapse/edge/config.yaml /opt/timelapse/edge/sftp_cache.yaml \
             /opt/timelapse/edge/siem_journal.cursor \
    && rm -rf /opt/timelapse/edge/keys \
    && chown -R timelapse:timelapse /opt/timelapse/edge

# ── Bootstrap config template ────────────────────────────────────
RUN printf 'headend_url: "%s"\ndevice_id: "${DEVICE_ID}"\nbootstrap_token: "${BOOTSTRAP_TOKEN}"\n' \
        "${HEADEND_URL}" > /opt/timelapse/edge/bootstrap.yaml.template \
    && chown timelapse:timelapse /opt/timelapse/edge/bootstrap.yaml.template

# ── Version stamp ────────────────────────────────────────────────
RUN echo "${TIMELAPSE_VERSION}" > /opt/timelapse/edge/VERSION \
    && echo "${HEADEND_URL}" > /opt/timelapse/edge/HEADEND_URL

# ── Systemd service ──────────────────────────────────────────────
# Note: systemd won't run inside Docker export, but the unit file
# is present so it activates correctly when deployed to real hardware.
COPY edge/scripts/timelapse-edge.service /etc/systemd/system/timelapse-edge.service
COPY edge/scripts/timelapse-bootstrap.service /etc/systemd/system/timelapse-bootstrap.service
COPY edge/scripts/timelapse-bt-pan.service /etc/systemd/system/timelapse-bt-pan.service
COPY edge/scripts/timelapse-bt-agent.service /etc/systemd/system/timelapse-bt-agent.service
COPY edge/scripts/timelapse-captive.service /etc/systemd/system/timelapse-captive.service
COPY edge/scripts/timelapse-totp.service /etc/systemd/system/timelapse-totp.service
COPY edge/scripts/bootstrap_agent.py /opt/timelapse/edge/scripts/bootstrap_agent.py
RUN chmod 0644 /etc/systemd/system/timelapse-*.service \
    && chmod 0755 /opt/timelapse/edge/scripts/*.sh

EXPOSE 22

# Default: run the agent directly (for container testing)
# On real hardware systemd starts it via the .service unit
CMD ["/opt/timelapse/venv/bin/python", "/opt/timelapse/edge/agent.py", \
     "--config", "/etc/timelapse/node-agent.conf"]
