####################################################################
# TimeLapse Pro — Edge node image (arm64 / Ubuntu 22.04)
#
# Build context: repo root (timelapse-pro/)
# Build:
#   docker buildx build --platform linux/arm64 \
#     -f headend/tools/Dockerfile.edge \
#     --build-arg HEADEND_URL=http://127.0.0.1:8000/api \
#     -t timelapse-edge:latest --load .
#
# Export rootfs:
#   docker export $(docker create timelapse-edge:latest) | gzip > rootfs.tar.gz
#
# Paths (match timelapse-edge.service):
#   Agent:  /opt/timelapse/edge/
#   Venv:   /opt/timelapse/venv/
#   Data:   /data/
#   Config: /etc/timelapse/
####################################################################
FROM arm64v8/ubuntu:22.04

ARG HEADEND_URL=http://127.0.0.1:8000/api
ARG TIMELAPSE_VERSION=unknown
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Copenhagen \
    TIMELAPSE_HEADEND_URL=${HEADEND_URL} \
    PYTHONUNBUFFERED=1

# ── Base packages ───────────────────────────────────────────────
# gphoto2/libgphoto2 pinned (2026-08-06, Claude). IMPORTANT CAVEAT, found by
# actually attempting this build (a pin picked without testing would have
# been silently wrong): TL-C87FF9587CA0 runs 2.5.28, but this Dockerfile
# builds on Ubuntu 22.04 (jammy) — jammy's repo doesn't carry 2.5.28 at all
# (2.5.28 is a noble/24.04-era version; `apt-cache policy` on a clean jammy
# image confirms the candidate is 2.5.27-1). Pinned to jammy's actual
# available version instead of a version that can never resolve here.
#
# This is a symptom of a bigger, unresolved architecture question: the
# orangepi4pro-noble target injects THIS (jammy-built) app layer onto a
# NOBLE (24.04) base image (see headend/tools/hardware/orangepi4pro-noble/
# build_noble_base.sh) — an OS-version mismatch between where gphoto2 is
# built and where it runs. Almost certainly fine in practice (glibc is
# backward-compatible; a jammy-built binary + its co-shipped libs generally
# run fine on a newer glibc), and inject_edge_image.py already copies the
# gphoto2 binary WITH its associated shared libraries (not just the binary
# alone) for exactly this reason — but this has only been verified by
# reasoning about it, not by an actual boot test on real hardware. Treat
# any noble-target boot failure around camera detection as the first place
# to look.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        ca-certificates curl gnupg2 \
        openssh-server openssh-client \
        iproute2 iputils-ping dnsutils \
        rsync autossh gphoto2=2.5.27-1 libgphoto2-6=2.5.27-1ubuntu0.1 libgphoto2-port12=2.5.27-1ubuntu0.1 \
        gpsd gpsd-clients bluez avahi-daemon libnss-mdns \
    && rm -rf /var/lib/apt/lists/*

# ── Service user ─────────────────────────────────────────────────
RUN useradd -m -s /bin/bash timelapse \
    && passwd -l timelapse \
    && passwd -l root

# ── Hardening (SSH) ──────────────────────────────────────────────
RUN mkdir -p /run/sshd \
    && sed -i \
        -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/' \
        -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
        -e 's/^#\?ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' \
        /etc/ssh/sshd_config \
    && echo "AllowUsers timelapse" >> /etc/ssh/sshd_config

# ── Directory structure ──────────────────────────────────────────
RUN mkdir -p \
        /opt/timelapse/edge \
        /opt/timelapse/venv \
        /etc/timelapse \
        /data \
        /run/timelapse \
    && chown -R timelapse:timelapse \
        /opt/timelapse \
        /etc/timelapse \
        /data \
        /run/timelapse

# ── Python venv ──────────────────────────────────────────────────
# Et nyt image skal kunne udføre samme QA som en opdateret Edge fra første boot.
COPY edge/requirements.txt /tmp/requirements.edge.txt
# Build-deps installeres midlertidigt og fjernes igen i samme RUN-lag.
# PyNaCl bygges med sin medfølgende libsodium, så venv'en ikke afhænger af,
# at et leverandør-image allerede har præcis samme systembibliotek.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc libffi-dev python3-dev make \
        libsodium-dev \
    && python3 -m venv /opt/timelapse/venv \
    && /opt/timelapse/venv/bin/pip install --quiet --no-cache-dir \
        -r /tmp/requirements.edge.txt \
    && apt-get remove -y gcc libffi-dev python3-dev make libsodium-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ── Agent source ─────────────────────────────────────────────────
# Training data, test suites, native source and offline authoring tools are not
# runtime dependencies. They remain in Git and are delivered only as explicit
# signed artifacts when a future maintenance case needs them.
COPY edge/ /opt/timelapse/edge/
RUN find /opt/timelapse/edge -type d \( -name __pycache__ -o -name .pytest_cache \) -prune -exec rm -rf {} + \
    && find /opt/timelapse/edge -type f \( -name '*.pyc' -o -name '*.pyo' -o -name 'Icon' \) -delete \
    && rm -rf /opt/timelapse/edge/ai/tests \
              /opt/timelapse/edge/training \
              /opt/timelapse/edge/npu_viplite \
              /opt/timelapse/edge/technician_ui.py \
    && find /opt/timelapse/edge/tools -maxdepth 1 -type f ! -name bootstrap_cli.py -delete \
    && rm -f /opt/timelapse/edge/api_token.txt /opt/timelapse/edge/bootstrap.yaml \
             /opt/timelapse/edge/config.yaml /opt/timelapse/edge/sftp_cache.yaml \
             /opt/timelapse/edge/siem_journal.cursor \
    && rm -rf /opt/timelapse/edge/keys \
    && chown -R timelapse:timelapse /opt/timelapse/edge

# ── Bootstrap config template ────────────────────────────────────
RUN printf 'headend_url: "%s"\ndevice_id: "${DEVICE_ID}"\nbootstrap_token: "${BOOTSTRAP_TOKEN}"\n' \
        "${HEADEND_URL}" > /opt/timelapse/edge/bootstrap.yaml.template \
    && chown timelapse:timelapse /opt/timelapse/edge/bootstrap.yaml.template

# ── Version stamp ────────────────────────────────────────────────
RUN echo "${TIMELAPSE_VERSION}" > /opt/timelapse/edge/VERSION \
    && echo "${HEADEND_URL}" > /opt/timelapse/edge/HEADEND_URL

# ── Systemd service ──────────────────────────────────────────────
# Note: systemd won't run inside Docker export, but the unit file
# is present so it activates correctly when deployed to real hardware.
COPY edge/scripts/timelapse-edge.service /etc/systemd/system/timelapse-edge.service
COPY edge/scripts/timelapse-bootstrap.service /etc/systemd/system/timelapse-bootstrap.service
COPY edge/scripts/timelapse-bt-pan.service /etc/systemd/system/timelapse-bt-pan.service
COPY edge/scripts/timelapse-bt-agent.service /etc/systemd/system/timelapse-bt-agent.service
COPY edge/scripts/timelapse-captive.service /etc/systemd/system/timelapse-captive.service
COPY edge/scripts/timelapse-totp.service /etc/systemd/system/timelapse-totp.service
COPY edge/scripts/timelapse-breakglass-setup.service /etc/systemd/system/timelapse-breakglass-setup.service
# 2026-08-06 (Claude): watchdog + timesync kørte allerede live på TL-C87FF9587CA0
# (manuelt tilføjet ved den maskines oprindelige, ikke-pipeline opsætning) men
# manglede helt fra denne pipeline — en frisk-flashet enhed ville aldrig få dem.
COPY edge/scripts/timelapse-watchdog.service /etc/systemd/system/timelapse-watchdog.service
COPY edge/scripts/timelapse-timesync.service /etc/systemd/system/timelapse-timesync.service
COPY edge/scripts/timelapse-timesync.timer /etc/systemd/system/timelapse-timesync.timer
COPY edge/scripts/bootstrap_agent.py /opt/timelapse/edge/scripts/bootstrap_agent.py
RUN chmod 0644 /etc/systemd/system/timelapse-*.service /etc/systemd/system/timelapse-*.timer \
    && chmod 0755 /opt/timelapse/edge/scripts/*.sh

EXPOSE 22

# Default: run the agent directly (for container testing)
# On real hardware systemd starts it via the .service unit
CMD ["/opt/timelapse/venv/bin/python", "/opt/timelapse/edge/agent.py", \
     "--config", "/etc/timelapse/node-agent.conf"]
